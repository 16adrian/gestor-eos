# Copia este archivo y renómbralo a .env (en la carpeta server)

# Cadena de conexión de PostgreSQL (la copias de Neon -> Connect)
DATABASE_URL=postgresql://usuario:clave@servidor/neondb?sslmode=require

# Clave secreta para firmar el login (escribe cualquier frase larga)
JWT_SECRET=cambia-esta-frase-por-una-larga-y-secreta

# Usuario administrador que crea el seed
ADMIN_EMAIL=admin@eos.com
ADMIN_PASSWORD=Admin123*

PORT=4000
